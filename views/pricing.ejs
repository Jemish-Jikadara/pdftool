<!DOCTYPE html>
<html lang="en">

    <head>

        <%- include('partials/head', { pageTitle: 'Pricing - ImgToolkit' }) %>

    </head>

    <body>

        <%- include('partials/header') %>

        <section class="pricing-page">

            <div class="wrap">

                <div class="pricing-header">

                    <h1>Simple Pricing</h1>

                    <p>
                        Start for free. Upgrade anytime when premium features
                        become available.
                    </p>

                </div>

                <div class="pricing-grid">

                    <!-- FREE -->

                    <div class="pricing-card">

                        <h2 class="plan">Free</h2>

                        <div class="price">
                            ₹0
                            <span>/ Forever</span>
                        </div>

                        <ul class="feature-list">

                            <li>✔ Unlimited Image Compression</li>
                            <li>✔ Resize Images</li>
                            <li>✔ JPG ⇄ PNG Conversion</li>
                            <li>✔ WebP Conversion</li>
                            <li>✔ Crop & Rotate</li>
                            <li>✔ Watermark Tool</li>

                        </ul>

                        <a href="/" class="plan-btn">

                            Get Started

                        </a>

                    </div>

                    <!-- PRO -->

                    <div class="pricing-card popular">

                        <span class="badge">

                            MOST POPULAR

                        </span>

                        <h2 class="plan">Pro</h2>

                        <div class="price">
                            ₹199
                            <span>/ month</span>
                        </div>

                        <ul class="feature-list">

                            <li>✔ Everything in Free</li>
                            <li>✔ Faster Processing</li>
                            <li>✔ Larger File Uploads</li>
                            <li>✔ Batch Processing</li>
                            <li>✔ Priority Support</li>
                            <li>✔ No Future Limits</li>

                        </ul>

                        <a href="/contact" class="plan-btn">

                            Coming Soon

                        </a>

                    </div>

                    <!-- ENTERPRISE -->

                    <div class="pricing-card coming-soon">

                        <h2 class="plan">Enterprise</h2>

                        <div class="price">
                            Custom
                        </div>

                        <ul class="feature-list">

                            <li>✔ Unlimited Usage</li>
                            <li>✔ Dedicated Support</li>
                            <li>✔ Team Access</li>
                            <li>✔ Private Deployment</li>
                            <li>✔ API Integration</li>
                            <li>✔ Custom Features</li>

                        </ul>

                        <a href="/contact" class="plan-btn">

                            Contact Sales

                        </a>

                    </div>

                </div>

                <div class="pricing-bottom">

                    <h2>

                        Need Something Custom?

                    </h2>

                    <p>

                        Contact us for enterprise solutions or custom image
                        processing services.

                    </p>

                    <a href="/contact" class="plan-btn"
                        style="max-width:250px;margin:auto;">

                        Contact Us

                    </a>

                </div>

            </div>

        </section>

        <%- include('partials/footer') %>

    </body>

</html>