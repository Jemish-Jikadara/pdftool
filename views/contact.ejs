<!DOCTYPE html>
<html lang="en">

<head>

    <%- include('partials/head', { pageTitle: 'Contact - ImgToolkit' }) %>

</head>

<body>

    <%- include('partials/header') %>

    <section class="hero">

        <div class="wrap">

            <span class="eyebrow">

                CONTACT US

            </span>

            <h1>

                We'd love to hear<br>

                from you.

            </h1>

            <p class="sub">

                Have a question, suggestion or found a bug?
                Send us a message and we'll get back to you as soon as possible.

            </p>

        </div>

    </section>

    <div class="sprocket-divider">

        <span></span><span></span><span></span>

        <div class="line"></div>

        <span></span><span></span><span></span>

    </div>

    <section class="wrap">

        <div class="contact-grid">

            <div class="contact-card">

                <h2>Send Message</h2>

                <form>

                    <div class="field">

                        <label>Name</label>

                        <input type="text" placeholder="Your Name">

                    </div>

                    <div class="field">

                        <label>Email</label>

                        <input type="email" placeholder="you@example.com">

                    </div>

                    <div class="field">

                        <label>Subject</label>

                        <input type="text" placeholder="Message Subject">

                    </div>

                    <div class="field">

                        <label>Message</label>

                        <textarea rows="6" placeholder="Write your message..."></textarea>

                    </div>

                    <button class="run-btn">

                        Send Message

                    </button>

                </form>

            </div>

            <div class="contact-card">

                <h2>Contact Information</h2>

                <p>

                    We usually reply within 24 hours.

                </p>

                <div class="contact-info">

                    <p><strong>Email</strong><br>support@imgtoolkit.com</p>

                    <p><strong>Availability</strong><br>Monday – Sunday</p>

                    <p><strong>Response Time</strong><br>Within 24 Hours</p>

                </div>

            </div>

        </div>

    </section>

    <%- include('partials/footer') %>

</body>

</html>